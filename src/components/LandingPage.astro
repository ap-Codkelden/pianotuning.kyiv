---
import { useTranslations, getLocalizedPath, languages } from '../i18n/translations';
import { getServices, getPrices, getSteps } from '../i18n/content';
import type { Lang } from '../i18n/translations';
import type { ServiceIconType } from '../i18n/content';
import '../styles/global.css';
import mapMarkerIcon from '../assets/map-marker.svg?url';
import pianoIcon from '../assets/piano.svg?url';
import mechanicsIcon from '../assets/mechanics.svg?url';
import voicingIcon from '../assets/voicing.svg?url';
import shieldIcon from '../assets/shield.svg?url';
import handset from  '../assets/phone.svg?url';
import Telegram from  '../assets/telegram.svg?url';
import Whatsapp from  '../assets/whatsapp.svg?url';
import pianoManImage from '../assets/piano_man.jpg?url';


interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const phoneNumber = '+38 (095) 700-91-12';
const phoneHref = 'tel:+380957009112';
const telegramHref = 'https://t.me/PianoTuningKyiv';
const whatsAppHref = 'https://wa.me/380957009112';
const emailAddress = 'pianotuning.kyiv@gmail.com';

const services = getServices(lang);
const prices = getPrices(lang);
const steps = getSteps(lang);

const serviceIcons: Record<ServiceIconType, string> = {
  piano: pianoIcon,
  mechanics: mechanicsIcon,
  voicing: voicingIcon,
  shield: shieldIcon,
};

const missionLines = t('hero.mission.text').split('\n');
---

  <!-- HEADER -->
  <header data-site-header class="site-header sticky top-0 z-30 min-h-50 border-b border-stone-900/10 bg-[#f7f1e8]/50 backdrop-blur">
    <div class="site-header-inner relative mx-auto flex min-h-50 max-w-7xl flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <!-- Nav left -->
      <nav class="mr-auto hidden items-center gap-7 pr-4 text-lg font-medium text-stone-700 lg:flex">
        <a href="#services" class="transition hover:text-stone-950">{t('nav.services')}</a>
        <a href="#process" class="transition hover:text-stone-950">{t('nav.process')}</a>
        <a href="#prices" class="transition hover:text-stone-950">{t('nav.prices')}</a>
        <a href="#contacts" class="transition hover:text-stone-950">{t('nav.contacts')}</a>
      </nav>

      <!-- Logo center -->
      <div class="absolute left-1/2 top-1/2 z-20 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-3 text-center">
        <div class="site-logo-shell flex h-50 w-50 shrink-0 items-center justify-center overflow-hidden">
          <img src="/pianotuning.svg" alt="PianoTuningKyiv logo" class="site-logo h-50 w-50 object-contain" />
        </div>
      </div>

      <button
        type="button"
        data-mobile-menu-button
        class="absolute right-5 top-4 z-30 inline-flex h-11 w-11 items-center justify-center rounded-full border border-stone-900/15 bg-white/65 text-stone-950 shadow-sm backdrop-blur transition hover:bg-white/85 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 7h14M5 12h14M5 17h14" />
        </svg>
      </button>

      <!-- Right: CTA + lang switcher -->
      <div class="ml-auto hidden items-center gap-2 lg:flex">
        <a href={phoneHref} data-conversion-cta class="inline-flex h-10 w-42 shrink-0 items-center justify-center rounded-full bg-stone-950 
        px-5 text-md font-semibold text-[#f7f1e8] transition hover:bg-stone-800">
          {t('nav.call')}
        </a>
        <!-- Language switcher -->
        <div class="hidden items-center gap-1 rounded-full border border-stone-900/15 bg-white/50 p-1 sm:flex">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={getLocalizedPath(code as Lang)}
              class={`rounded-full px-3 py-1 text-xs font-semibold transition ${
                lang === code
                  ? 'bg-stone-950 text-[#f7f1e8]'
                  : 'text-stone-600 hover:text-stone-950'
              }`}
            >
              {label}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div
      id="mobile-menu"
      data-mobile-menu
      class="mobile-menu absolute inset-x-4 top-full z-40 rounded-3xl border border-stone-900/10 bg-[#f7f1e8]/95 p-4 shadow-2xl shadow-stone-950/15 backdrop-blur lg:hidden"
    >
      <nav class="grid gap-1 text-base font-semibold text-stone-800">
        <a href="#services" class="rounded-2xl px-4 py-3 transition hover:bg-white/60">{t('nav.services')}</a>
        <a href="#process" class="rounded-2xl px-4 py-3 transition hover:bg-white/60">{t('nav.process')}</a>
        <a href="#prices" class="rounded-2xl px-4 py-3 transition hover:bg-white/60">{t('nav.prices')}</a>
        <a href="#contacts" class="rounded-2xl px-4 py-3 transition hover:bg-white/60">{t('nav.contacts')}</a>
      </nav>
      <div class="mt-4 flex items-center justify-between gap-3 border-t border-stone-900/10 pt-4">
        <a href={phoneHref} data-conversion-cta class="inline-flex h-11 flex-1 items-center justify-center rounded-full bg-stone-950 px-5 text-sm font-semibold text-[#f7f1e8] transition hover:bg-stone-800">
          {t('nav.call')}
        </a>
        <div class="flex items-center gap-1 rounded-full border border-stone-900/15 bg-white/50 p-1">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={getLocalizedPath(code as Lang)}
              class={`rounded-full px-3 py-1 text-xs font-semibold transition ${
                lang === code
                  ? 'bg-stone-950 text-[#f7f1e8]'
                  : 'text-stone-600 hover:text-stone-950'
              }`}
            >
              {label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden px-5 pb-10 pt-12 md:px-8 md:pb-8 md:pt-20">
      <div class="absolute -left-32 top-12 h-80 w-80 rounded-full bg-amber-200/50 blur-3xl pointer-events-none"></div>
      <div class="absolute -right-16 top-24 h-96 w-96 rounded-full bg-stone-300/50 blur-3xl pointer-events-none"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-6 lg:grid-cols-[1.02fr_0.98fr] lg:gap-12">
        <div style="animation: fadeUp 0.7s ease both;">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-stone-900/10 bg-white/60 px-4 py-2 text-sm text-stone-700 shadow-sm backdrop-blur">
            <img src={mapMarkerIcon} alt="" class="h-6 w-auto" />
            {t('hero.badge')}
          </div>
          <h1 class="font-display max-w-4xl text-[2.4rem] font-semibold leading-[0.92] tracking-tight text-stone-950 md:text-[5.12rem]">
            {t('hero.h1')}
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-stone-700 md:text-xl">
            {t('hero.sub')}
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#contacts" class="inline-flex h-14 items-center justify-center gap-2 rounded-full bg-stone-950 px-7 text-base font-semibold text-[#f7f1e8] transition hover:bg-stone-800">
              {t('hero.cta')}
            </a>
            <a href={phoneHref} data-conversion-cta class="inline-flex h-14 items-center justify-center gap-2 rounded-full border border-stone-900/20 bg-white/40 px-7 text-base font-semibold text-stone-950 transition hover:bg-white/70">
              <img src={handset} alt="" class="h-6 w-auto" />{phoneNumber}
            </a>
          </div>
        </div>
        <div style="animation: fadeScale 0.8s ease 0.1s both;">
          <div class="rounded-[2.2rem] border border-stone-900/10 bg-stone-950 p-2 shadow-2xl shadow-stone-950/25 lg:-mt-52">
            <div class="relative min-h-90 overflow-hidden rounded-[1.7rem] bg-linear-to-br from-stone-800 via-stone-950 to-black p-6 text-white md:p-8">
              <img src={pianoManImage} alt="" class="absolute inset-0 h-full w-full object-cover object-center opacity-75" />
              <div class="absolute inset-0 bg-linear-to-br from-black/60 via-stone-950/35 to-black/75 pointer-events-none"></div>
              <div class="absolute inset-0 opacity-90 pointer-events-none" style="background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.17), transparent 30%), radial-gradient(circle at 78% 72%, rgba(217,164,65,0.35), transparent 34%);"></div>
              <div class="absolute bottom-6 right-6 z-10 flex justify-end md:bottom-8 md:right-8">
                <div class="max-w-md px-1 py-2 text-right">
                  <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-200/90">{t('hero.mission.label')}</p>
                  <p class="font-epigraph mt-3 text-2xl font-normal leading-[1.12] text-amber-100 md:text-3xl">
                    {missionLines.map((line, i) => (
                      <>
                        {line}
                        {i < missionLines.length - 1 && <br />}
                      </>
                    ))}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="px-5 pb-10 pt-8 md:px-8 md:pb-14 md:pt-12">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-10 max-w-3xl text-center reveal">
          <h2 class="font-display text-4xl font-semibold tracking-tight text-stone-950 md:text-6xl">{t('services.title')}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-stone-600 md:text-lg">{t('services.sub')}</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {services.map((service, index) => (
            <div class="reveal md:col-span-2 lg:col-span-4" style={`transition-delay: ${index * 60}ms`}>
              <div class="h-full rounded-[1.8rem] border border-stone-900/10 bg-white/55 shadow-sm backdrop-blur p-6 md:p-8">
                <div class="flex items-center gap-5">
                  <div class="relative flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-stone-950 text-[#f7f1e8]">
                    <img src={serviceIcons[service.iconType]} alt="" class="h-16 w-16" />
                  </div>
                  <h3 class="font-display text-3xl font-semibold leading-tight md:text-4xl">{service.title}</h3>
                </div>
                <p class="mt-3 max-w-5xl leading-7 text-stone-600">{service.text}</p>
                {service.details && (
                  <div class="mt-7 grid gap-5 lg:grid-cols-3">
                    {service.details.map((detail) => (
                      <div class="rounded-3xl bg-[#fffaf1] p-5 ring-1 ring-stone-900/10">
                        <h4 class="font-display text-2xl font-semibold leading-tight text-stone-950">{detail.heading}</h4>
                        {detail.paragraphs?.map((p) => (
                          <p class="mt-3 text-sm leading-7 text-stone-700 md:text-base">{p}</p>
                        ))}
                        {detail.bullets && (
                          <ul class="mt-3 space-y-3 text-sm leading-7 text-stone-700 md:text-base">
                            {detail.bullets.map((bullet) => (
                              <li class="flex gap-3">
                                <svg class="mt-1 h-4 w-4 shrink-0 text-stone-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.6 2.6L16.5 9"/></svg>
                                <span>{bullet}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="-mt-10 px-5 pb-10 pt-10 md:-mt-14 md:px-8 md:pb-14 md:pt-12">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-10 max-w-3xl text-center reveal">
          <h2 class="font-display text-4xl font-semibold tracking-tight text-stone-950 md:text-6xl">{t('process.title')}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-stone-600 md:text-lg">{t('process.sub')}</p>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {steps.map((step, index) => (
            <div class="reveal rounded-[1.8rem] border border-stone-900/10 bg-white/55 p-6 shadow-sm backdrop-blur" style={`transition-delay: ${index * 60}ms`}>
              <h3 class="font-display mt-4 text-4xl font-semibold leading-tight">{step.title}</h3>
              <p class="mt-3 whitespace-pre-line leading-7 text-stone-600">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICES -->
    <section id="prices" class="px-5 pb-10 pt-2 md:px-8 md:pb-10">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-10 max-w-3xl text-center reveal">
          <h2 class="font-display text-4xl font-semibold tracking-tight text-stone-950 md:text-6xl">{t('prices.title')}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-stone-600 md:text-lg">{t('prices.sub')}</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {prices.map((price, index) => (
            <div class="reveal rounded-[1.8rem] border border-stone-900/10 bg-white/55 p-6 shadow-sm backdrop-blur" style={`transition-delay: ${index * 60}ms`}>
              <h3 class="font-display text-3xl font-semibold leading-tight text-stone-950">{price.title}</h3>
              <p class="mt-6 whitespace-pre-line text-[0.9rem] font-semibold leading-tight tracking-tight text-stone-950 md:text-[1.125rem]">{price.value}</p>
              <p class="mt-4 text-sm leading-7 text-stone-600">{price.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACTS -->
    <section id="contacts" class="px-5 pb-6 pt-2 md:px-8 md:pb-8">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-[2.4rem] bg-stone-950 text-[#f7f1e8] shadow-2xl shadow-stone-950/25">
        <div class="grid gap-0 lg:grid-cols-[1.08fr_0.92fr]">
          <div class="p-7 md:p-12">
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-amber-200">{t('contacts.eyebrow')}</p>
            <h2 class="font-display mt-4 max-w-3xl text-5xl font-semibold leading-[0.98] md:text-7xl">
              {t('contacts.title')}
            </h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-white/75 md:text-lg">
              {t('contacts.sub')}
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row flex-wrap">
              <a href={phoneHref} data-conversion-cta class="inline-flex h-14 items-center justify-center gap-2 rounded-full bg-[#f7f1e8] px-7 text-base font-semibold text-stone-950 transition hover:bg-white">
                <img src={handset} alt="" class="h-6 w-auto" />
                {t('nav.call')}
              </a>
              <a href={telegramHref} data-conversion-cta class="inline-flex h-14 items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-7 text-base font-semibold text-white transition hover:bg-white/15">
                <img src={Telegram} alt="" class="h-6 w-auto" />
                Telegram
              </a>
              <a href={whatsAppHref} data-conversion-cta target="_blank" rel="noopener noreferrer" class="inline-flex h-14 items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-7 text-base font-semibold text-white transition hover:bg-white/15">
                <img src={Whatsapp} alt="" class="h-6 w-auto" />
                WhatsApp
              </a>
            </div>
          </div>
          <div class="border-t border-white/10 bg-white/5 p-7 md:p-12 lg:border-l lg:border-t-0">
            <div class="grid gap-5">
              <div class="rounded-3xl border border-white/10 bg-white/10 p-5">
                <div class="flex items-center gap-3 text-amber-200">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16.9v2.2a2 2 0 0 1-2.2 2A18.9 18.9 0 0 1 3 6.2 2 2 0 0 1 5 4h2.2a2 2 0 0 1 2 1.7l.4 2a2 2 0 0 1-.6 1.8l-1 1a15.2 15.2 0 0 0 5.5 5.5l1-1a2 2 0 0 1 1.8-.6l2 .4a2 2 0 0 1 1.7 2.1Z"/></svg>
                  <p class="text-sm font-semibold uppercase tracking-[0.18em]">{t('contacts.phone_label')}</p>
                </div>
                <a href={phoneHref} data-conversion-cta class="mt-4 block text-2xl font-semibold transition hover:text-amber-100">{phoneNumber}</a>
              </div>
              <div class="rounded-3xl border border-white/10 bg-white/10 p-5">
                <div class="flex items-center gap-3 text-amber-200">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                  <p class="text-sm font-semibold uppercase tracking-[0.18em]">{t('contacts.email_label')}</p>
                </div>
                <a href={`mailto:${emailAddress}`} class="mt-4 block break-all text-lg font-semibold transition hover:text-amber-100 md:text-xl">{emailAddress}</a>
              </div>
              <div class="rounded-3xl border border-white/10 bg-white/10 p-5">
                <div class="flex items-center gap-3 text-amber-200">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.7"/></svg>
                  <p class="text-sm font-semibold uppercase tracking-[0.18em]">{t('contacts.geo_label')}</p>
                </div>
                <p class="mt-4 text-xl font-semibold">{t('contacts.geo_value')}</p>
              </div>
              <div class="rounded-3xl border border-white/10 bg-white/10 p-5">
                <div class="flex items-center gap-3 text-amber-200">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                  <p class="text-sm font-semibold uppercase tracking-[0.18em]">{t('contacts.schedule_label')}</p>
                </div>
                <p class="mt-4 text-xl font-semibold">{t('contacts.schedule_value')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-stone-900/10 px-5 py-8 md:px-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 text-sm text-stone-600 md:flex-row md:items-center md:justify-between">
      <p>{t('footer.copy')}</p>
      <p>{t('footer.tagline')}</p>
    </div>
  </footer>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeScale {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .site-header {
    overflow-anchor: none;
    transition:
      min-height 320ms ease,
      background-color 260ms ease,
      box-shadow 260ms ease;
    will-change: min-height, background-color, box-shadow;
  }
  .site-header-inner {
    transition:
      min-height 320ms ease,
      padding-top 320ms ease,
      padding-bottom 320ms ease;
    will-change: min-height, padding-top, padding-bottom;
  }
  .site-logo-shell,
  .site-logo {
    transition:
      height 320ms ease,
      width 320ms ease,
      transform 320ms ease;
    will-change: height, width, transform;
  }
  .site-header.is-scrolled {
    min-height: 5.5rem;
    background-color: rgba(247, 241, 232, 0.84);
    box-shadow: 0 18px 42px rgba(28, 25, 23, 0.08);
  }
  .site-header.is-scrolled .site-header-inner {
    min-height: 5.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .site-header.is-scrolled .site-logo-shell,
  .site-header.is-scrolled .site-logo {
    height: 6.25rem;
    width: 6.25rem;
  }
  .mobile-menu {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const mobileMenuButton = document.querySelector<HTMLButtonElement>('[data-mobile-menu-button]');
  let isHeaderCompact = false;
  let headerFrame = 0;

  const updateHeader = () => {
    if (!header) return;

    const shouldBeCompact = isHeaderCompact
      ? window.scrollY > 18
      : window.scrollY > 42;

    if (shouldBeCompact === isHeaderCompact) return;

    isHeaderCompact = shouldBeCompact;
    header.classList.toggle('is-scrolled', isHeaderCompact);
  };
  const scheduleHeaderUpdate = () => {
    if (headerFrame) return;

    headerFrame = window.requestAnimationFrame(() => {
      headerFrame = 0;
      updateHeader();
    });
  };
  const setMobileMenuOpen = (isOpen: boolean) => {
    mobileMenu?.classList.toggle('is-open', isOpen);
    mobileMenuButton?.setAttribute('aria-expanded', String(isOpen));
  };

  updateHeader();
  window.addEventListener('scroll', scheduleHeaderUpdate, { passive: true });
  mobileMenuButton?.addEventListener('click', () => {
    setMobileMenuOpen(!mobileMenu?.classList.contains('is-open'));
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMobileMenuOpen(false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMobileMenuOpen(false);
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
