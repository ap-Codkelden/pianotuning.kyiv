---
import { useTranslations } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const title = t('meta.title');
const description = t('meta.description');

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://pianotuningkyiv.pro/#business',
  name: 'PianoTuningKyiv',
  description,
  url: 'https://pianotuningkyiv.pro/',
  telephone: '+380957009112',
  email: 'pianotuning.kyiv@gmail.com',
  image: 'https://pianotuningkyiv.pro/pianotuning.svg',
  priceRange: '800–8000 UAH',
  areaServed: {
    '@type': 'AdministrativeArea',
    name: lang === 'uk' ? 'Київ та Київська область' : 'Kyiv & Kyiv region',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kyiv',
    addressRegion: 'Kyiv Oblast',
    addressCountry: 'UA',
  },
  sameAs: [
    'https://t.me/PianoTuningKyiv',
    'https://wa.me/380957009112',
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <!-- hreflang tags for SEO (absolute URLs) -->
    <link rel="alternate" hreflang="uk" href="https://pianotuningkyiv.pro/" />
    <link rel="alternate" hreflang="en" href="https://pianotuningkyiv.pro/en/" />
    <link rel="alternate" hreflang="x-default" href="https://pianotuningkyiv.pro/" />
    <!-- LocalBusiness structured data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18200322333"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('js', new Date());
      gtag('config', 'AW-18200322333');
    </script>
    <!-- Conversion event fires on contact CTA clicks, not on page load -->
    <script is:inline>
      window.reportConversion = function (callback) {
        var fired = false;
        gtag('event', 'conversion', {
          'send_to': 'AW-18248584122/n5QxCNvQkagdELqXzf1D',
          'value': 1.0,
          'currency': 'UAH',
          'transaction_id': '',
          'event_callback': function () {
            if (!fired && typeof callback === 'function') {
              fired = true;
              callback();
            }
          }
        });
        return false;
      };

      document.addEventListener('DOMContentLoaded', function () {
        var ctas = document.querySelectorAll('[data-conversion-cta]');
        ctas.forEach(function (cta) {
          cta.addEventListener('click', function () {
            window.reportConversion();
          });
        });
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
